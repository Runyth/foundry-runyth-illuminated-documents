{{#each groups}}
  <fieldset class="idoc-extension-field-group" data-extension-id="{{extensionId}}">
    <legend><i class="fa-solid fa-puzzle-piece"></i> {{title}}</legend>
    {{#each fields}}
      {{#if isHidden}}
        <input type="hidden" name="{{fieldName}}" value="{{value}}" data-extension-field-name="{{fieldName}}">
      {{else}}
        <div class="form-group idoc-extension-field" data-extension-field="{{key}}" data-extension-owner="{{extensionId}}">
          <label for="{{fieldName}}">{{label}}{{#if required}} <span aria-label="Required">*</span>{{/if}}</label>
          <div class="form-fields">
            {{#if isSelect}}
              <select id="{{fieldName}}" name="{{fieldName}}" {{#if required}}required{{/if}} {{#if disabled}}disabled{{/if}}>
                {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            {{/if}}
            {{#if isCheckbox}}
              <input id="{{fieldName}}" type="checkbox" name="{{fieldName}}" {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}}>
            {{/if}}
            {{#if isText}}
              <input id="{{fieldName}}" type="text" name="{{fieldName}}" value="{{value}}" placeholder="{{placeholder}}" {{#if required}}required{{/if}} {{#if disabled}}disabled{{/if}}>
            {{/if}}
            {{#if isNumber}}
              <input id="{{fieldName}}" type="number" name="{{fieldName}}" value="{{value}}" {{#if min}}min="{{min}}"{{/if}} {{#if max}}max="{{max}}"{{/if}} {{#if step}}step="{{step}}"{{/if}} {{#if required}}required{{/if}} {{#if disabled}}disabled{{/if}}>
            {{/if}}
            {{#if isCustom}}
              <div id="{{fieldName}}" class="idoc-extension-custom-field" data-extension-custom="{{fieldName}}"></div>
            {{/if}}
          </div>
          {{#if hint}}<p class="notes">{{hint}}</p>{{/if}}
        </div>
      {{/if}}
    {{/each}}
  </fieldset>
{{/each}}
